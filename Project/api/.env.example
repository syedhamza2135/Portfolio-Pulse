# PortfolioPulse API - Environment Variables
# Copy this file to .env and fill in your values

# ======================
# Server Configuration
# ======================
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:3000

# ======================
# Database
# ======================
MONGO_URI=mongodb://localhost:27017/portfoliopulse
# Or MongoDB Atlas:
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/portfoliopulse

# ======================
# Authentication
# ======================
# Generate a secure secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-min-32-chars

# ======================
# External APIs
# ======================

# Alpha Vantage (Stock Prices) - FREE TIER
# Get free API key: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key

# NewsAPI (News Articles) - FREE TIER
# Get free API key: https://newsapi.org/register
NEWSAPI_KEY=your_newsapi_key

# Finnhub (Backup Stock API) - OPTIONAL
# FINNHUB_API_KEY=your_finnhub_key

# ======================
# Sentiment Analysis
# ======================
# Python sentiment service URL
PYTHON_SENTIMENT_URL=http://localhost:8000

# ======================
# Email Alerts (SendGrid)
# ======================
# Get free API key: https://signup.sendgrid.com/
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=alerts@portfoliopulse.app
# Or use your verified email

# ======================
# Frontend URL (for email links)
# ======================
FRONTEND_URL=http://localhost:3000

# ======================
# Scheduled Jobs (CRON)
# ======================
# Price update schedule (default: every 15 min during market hours)
# Format: minute hour day month weekday
PRICE_UPDATE_CRON=*/15 14-20 * * 1-5

# Risk calculation schedule (default: daily at 23:00 UTC = 6PM ET)
RISK_CALC_CRON=0 23 * * *

# ======================
# Advanced Configuration
# ======================
# Rate limiting
# API_RATE_LIMIT_WINDOW_MS=60000
# API_RATE_LIMIT_MAX_REQUESTS=100

# Cache TTL (milliseconds)
# PRICE_CACHE_TTL=300000
# NEWS_CACHE_TTL=14400000