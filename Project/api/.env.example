# ==============================================================================
# PORTFOLIO PULSE - API ENVIRONMENT VARIABLES (EXAMPLE)
# Copy this file to .env and fill in the actual values.
# ==============================================================================

# --- SERVER CONFIG ---
NODE_ENV=development
PORT=5000
# The URL of your frontend application (used for CORS)
CORS_ORIGIN=http://localhost:3000

# --- DATABASE ---
# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/dbname

# --- SECURITY ---
# Generate a secure secret using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_32_character_hex_string_here
JWT_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

# --- MARKET DATA APIs ---
# Get keys from: https://www.alphavantage.co/ and https://finnhub.io/
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key
FINNHUB_API_KEY=your_finnhub_key

# --- BACKGROUND JOBS ---
PRICE_UPDATE_ENABLED=true
# Default: Every 15 mins during Mon-Fri market hours
# Note: Ensure cron hours align with your server's timezone (usually UTC)
PRICE_UPDATE_CRON="*/15 9-16 * * 1-5"

# --- RATE LIMITING ---
# Window in milliseconds (e.g., 15 minutes)
RATE_LIMIT_WINDOW_MS=900000
# Max requests per window per IP
RATE_LIMIT_MAX_REQUESTS=100