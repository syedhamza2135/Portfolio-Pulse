{
  "name": "portfoliopulse-api",
  "version": "1.0.0",
  "description": "PortfolioPulse Backend API - AI-powered investment tracking",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "test": "jest --coverage",
    "lint": "eslint src/",
    "format": "prettier --write \"src/**/*.js\"",
    "python:start": "cd sentiment_service && python main.py",
    "python:install": "cd sentiment_service && pip install -r requirements.txt"
  },
  "dependencies": {
    "@apollo/server": "^4.10.0",
    "@sendgrid/mail": "^8.1.6",
    "axios": "^1.6.2",
    "bcrypt": "^5.1.1",
    "cors": "^2.8.5",
    "dataloader": "^2.2.2",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.1.5",
    "graphql": "^16.8.1",
    "graphql-validation-complexity": "^0.4.2",
    "helmet": "^7.1.0",
    "joi": "^17.11.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "node-cron": "^3.0.3",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "prettier": "^3.1.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "keywords": [
    "portfolio",
    "investment",
    "stocks",
    "crypto",
    "sentiment-analysis",
    "fintech",
    "ai",
    "graphql",
    "rest-api"
  ],
  "author": "PortfolioPulse Team",
  "license": "MIT"
}
